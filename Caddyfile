createmanager.duckdns.org {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

# the participant portal is a separate build with its own route set, so a
# contestant never even downloads the jury pages
contest.createmanager.duckdns.org {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend-participant:80
    }
}
