YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=http://localhost:8000/auth/callback/yandex/
CODEFORCES_TEST_KEY=your_codeforces_test_key
CODEFORCES_TEST_SECRET=your_codeforces_test_secret
POSTGRES_DB=sample_db
POSTGRES_USER=sample_user
POSTGRES_PASSWORD=sample_password
SECRET_KEY=your_secret_key_goes_here
CORS_ORIGINS=http://localhost:5173
# required by backend/settings.py - the backend will not start without them
CF_CLIENT_ID=your_codeforces_key
CF_CLIENT_SECRET=your_codeforces_secret
# OpenRouter key of the AI authoring service (services/ai-authoring)
OPENAI_API_KEY=your_openrouter_api_key

# S3 storage (RustFS) root credentials, invent your own (letters/digits only): openssl rand -hex 24
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_at_least_8_chars

# prod: CORS_ORIGINS=https://createmanager.duckdns.org,https://contest.createmanager.duckdns.org
# optional: parallel judge runs on the server (default 2)
# JUDGE_WORKERS=2

# --- AI authoring service (services/ai-authoring) ---
# the backend proxies /api/ai/* here; inside compose the default is right
# AI_SERVICE_URL=http://ai-authoring:8100
# re-read recently opened problems from Polygon every N minutes
# SYNC_INTERVAL_MINUTES=5
# output cap per model call (OpenRouter reserves it in its balance check)
# LLM_MAX_TOKENS=32000

# --- export to ejudge (optional) ---
# SSH as the user ejudge runs under; key + known_hosts go to ./secrets/ejudge/
# (mounted into backend/worker at /run/secrets/ejudge)
# EJUDGE_SSH_HOST=ejudge.example.org
# EJUDGE_SSH_PORT=22
# EJUDGE_SSH_USER=ejudge
# EJUDGE_SSH_KEY_PATH=/run/secrets/ejudge/id_ed25519
# EJUDGE_SSH_KNOWN_HOSTS=/run/secrets/ejudge/known_hosts
# EJUDGE_JUDGES_DIR=/home/judges
# EJUDGE_CXX=g++ -O2 -std=gnu++20
# web interface, to reload the contest config after an export
# EJUDGE_URL=https://ejudge.example.org/cgi-bin
# EJUDGE_LOGIN=
# EJUDGE_PASSWORD=
